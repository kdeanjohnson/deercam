# Everything here can also be set on the Settings page in the UI, which saves to DATA_DIR/settings.json
# (those saved values win over this file).

# Reveal (Tactacam) login, optional: connects the first ranch on its first sync, and lets it sign in
# again by itself. Otherwise connect Reveal accounts in Settings (passwords there aren't kept).
REVEAL_EMAIL=
REVEAL_PASSWORD=

# Vision LLM: grok, claude, openai, gemini, or custom (any OpenAI-compatible server)
VISION_PROVIDER=grok
# XAI_API_KEY= / ANTHROPIC_API_KEY= / OPENAI_API_KEY= / GEMINI_API_KEY= / CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:11434/v1
# VISION_MODEL=          # the buck work (antler double-check, matching); blank = the provider's default (Grok: grok-4.7)
# VISION_FAST_MODEL=     # the first look at every crop, and name ideas; blank = the provider's default (Grok: grok-4.3)
# AI_MONTHLY_LIMIT=      # dollars of AI per ranch per month; blank = no limit (the admin can also set it in Settings)

# Seasons are antler years starting on this month-day
# SEASON_START=04-01
# REGION=               # blank = named from where the cameras are placed on the Map
# SYNC_INTERVAL_HOURS=0  # check Reveal for new photos this often while the UI runs

# Encrypts saved Reveal sign-in tokens. Blank: a key made in DATA_DIR/.secret_key. On a server, set it here
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# DEERCAM_SECRET_KEY=

# Where people open DeerCam; used in the links the command line prints
# PUBLIC_URL=http://localhost:8600

# On a server with docker compose: the domain Caddy gets an HTTPS certificate for, e.g. deer.example.com
# DEERCAM_DOMAIN=

# Optional tuning
# DATA_DIR=data
# TORCH_DEVICE=        # blank = best available (cuda, then Apple mps, then cpu)
# DETECTOR_CONF=0.35
# MIN_CROP_PX=80
# AUTO_ACCEPT_CONFIDENCE=0.85
# MATCH_CANDIDATES=3
# REFS_PER_BUCK=2
# BURST_GAP_SECONDS=180
# AUTO_GROUP=1
