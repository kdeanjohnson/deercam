# Everything here can also be set on the Settings page in the UI, which saves to DATA_DIR/settings.json
# (those saved values win over this file).

# Reveal (Tactacam) login - the account the cameras are shared with
REVEAL_EMAIL=
REVEAL_PASSWORD=

# Vision LLM: grok, claude, openai, gemini, or custom (any OpenAI-compatible server)
VISION_PROVIDER=grok
# XAI_API_KEY= / ANTHROPIC_API_KEY= / OPENAI_API_KEY= / GEMINI_API_KEY= / CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:11434/v1
# VISION_MODEL=          # blank = the provider's default (GROK_MODEL / CLAUDE_MODEL also still work)
# VISION_FAST_MODEL=     # used for quick UI calls like name ideas

# Seasons are antler years starting on this month-day
# SEASON_START=04-01
# REGION=               # blank = named from where the cameras are placed on the Map
# SYNC_INTERVAL_HOURS=0  # check Reveal for new photos this often while the UI runs

# Optional tuning
# DATA_DIR=data
# TORCH_DEVICE=        # blank = best available (cuda, then Apple mps, then cpu)
# DETECTOR_CONF=0.35
# MIN_CROP_PX=80
# AUTO_ACCEPT_CONFIDENCE=0.85
# MATCH_CANDIDATES=3
# REFS_PER_BUCK=2
# BURST_GAP_SECONDS=180
# AUTO_GROUP=1
